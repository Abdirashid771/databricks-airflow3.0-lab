{
  "datasets": [
    {
      "name": "c857a9e9",
      "displayName": "Posts Over Time Dataset",
      "queryLines": [
        "SELECT\n",
        "  PostCreationDate,\n",
        "  PostId\n",
        "FROM\n",
        "  data_lab.default.marts_posts_users\n",
        "WHERE\n",
        "  PostCreationDate IS NOT NULL\n",
        "  AND PostId IS NOT NULL"
      ],
      "catalog": "data_lab",
      "schema": "default"
    },
    {
      "name": "top_tags_dataset",
      "displayName": "Top Tags Dataset",
      "queryLines": [
        "SELECT\n",
        "  tag_exploded,\n",
        "  SUM(tags_count) AS total_tags_count\n",
        "FROM\n",
        "  data_lab.default.marts_top_tags\n",
        "WHERE\n",
        "  tag_exploded IS NOT NULL\n",
        "GROUP BY\n",
        "  tag_exploded\n",
        "ORDER BY\n",
        "  total_tags_count DESC,\n",
        "  tag_exploded"
      ]
    },
    {
      "name": "baf096f2",
      "displayName": "Average Answer Score by User",
      "queryLines": [
        "select\r\n",
        "  avg(Score) as average_answer_score,\r\n",
        "  Reputation,\r\n",
        "  Id as UserId\r\n",
        "from\r\n",
        "  data_lab.default.marts_posts_users\r\n",
        "where\r\n",
        "  PostTypeName = 'Answer'\r\n",
        "group by\r\n",
        "  Id,\r\n",
        "  Reputation"
      ]
    }
  ],
